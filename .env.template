# Jev client configuration.
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit secrets.

# JevEmbed decision server. Use http://127.0.0.1:8001 for local GPU inference,
# or a remote host like http://192.168.1.242:8001.
JEV_ENDPOINT=http://127.0.0.1:8001/v1/systemone

# Model name registered in JevEmbed (check /v1/models).
JEV_MODEL=jevembed-nethack

# API key: "local" for self-hosted JevEmbed, or a TypeSafe key for hosted.
JEV_API_KEY=local

# Monthly spend limit in USD. Local endpoints skip the budget check.
JEV_BUDGET_USD=0

# Optional: character selection for local NetHack.
# Format: role:race:gender:align, or "random".
# Examples: Valkyrie:dwarf:female:lawful, Wizard:elf:male:chaotic, random
# JEV_CHAR=Valkyrie:dwarf:female:lawful
